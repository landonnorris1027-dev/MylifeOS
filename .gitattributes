# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Git LFS
dist/** filter=lfs diff=lfs merge=lfs -text
dist/win-unpacked/** filter=lfs diff=lfs merge=lfs -text
node_modules/electron/dist/electron.exe filter=lfs diff=lfs merge=lfs -text
**/*.exe filter=lfs diff=lfs merge=lfs -text
**/*.asar filter=lfs diff=lfs merge=lfs -text

# Binary files (no line ending conversion)
*.ico binary
*.png binary
*.jpg binary
*.woff2 binary
