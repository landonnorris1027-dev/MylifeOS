{
  "name": "mylifeos",
  "version": "0.1.1",
  "private": true,
  "main": "electron.js",
  "homepage": "./",
  "dependencies": {
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^16.18.61",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.1.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "typecheck": "tsc --noEmit",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "check:electron": "node -c electron.js && node -c preload.js && node -c electron-timer-restore.js && node -c electron-window-target.js",
    "verify:quality": "npm run typecheck && npm run test && npm run build",
    "verify:release": "npm run verify:quality && npm run check:electron",
    "clean:build": "node ./scripts/clean-build.js",
    "prod": "node ./scripts/start-electron.js",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on tcp:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 NODE_ENV=development node ./scripts/start-electron.js\"",
    "electron:build": "npm run verify:release && npm run clean:build && electron-builder -w -c.extraMetadata.main=electron.js",
    "package:win": "npm run verify:release && electron-packager . MyLifeOS --platform=win32 --arch=x64 --out=release --overwrite --ignore=node_modules/electron-builder --icon=assets/icon.ico"
  },
  "build": {
    "appId": "com.mylifeos.app",
    "productName": "MyLifeOS",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "build/**/*",
      "electron.js",
      "preload.js",
      "electron-timer-restore.js",
      "electron-window-target.js",
      "assets/icon.ico"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "out"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
